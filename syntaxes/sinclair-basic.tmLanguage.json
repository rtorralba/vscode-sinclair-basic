{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sinclair BASIC",
  "scopeName": "source.sinclair-basic",
  "patterns": [
    {
      "name": "entity.name.tag.line-number.sinclair-basic",
      "match": "^\\s*(\\d+)"
    },
    {
      "include": "#remComment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#flowControl"
    },
    {
      "include": "#displayAttributes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtInFunctions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "remComment": {
      "patterns": [
        {
          "name": "comment.line.rem.sinclair-basic",
          "match": "\\b(?i:REM)\\b.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sinclair-basic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.control.sinclair-basic",
          "match": "\\{(?i:INK|PAPER|FLASH|BRIGHT|INVERSE|OVER|AT|TAB|CODE|#[0-9A-Fa-f]{1,2}|\\\\x[0-9A-Fa-f]{1,2}|[A-Ua-u])\\b[^}]*\\}"
        },
        {
          "name": "constant.character.escape.sinclair-basic",
          "match": "\\\\."
        }
      ]
    },
    "flowControl": {
      "patterns": [
        {
          "name": "keyword.control.jbas",
          "match": "\\b(?i:GO\\s*TO|GOTO|GO\\s*SUB|GOSUB|RETURN|IF|THEN|FOR|TO|STEP|NEXT|STOP|RUN|CONTINUE)\\b"
        }
      ]
    },
    "displayAttributes": {
      "patterns": [
        {
          "name": "keyword.other.display.jbas",
          "match": "\\b(?i:BORDER|PAPER|INK|FLASH|BRIGHT|INVERSE|OVER|CLS|BEEP|PAUSE|PLOT|DRAW|CIRCLE)\\b"
        },
        {
          "name": "support.function.print.jbas",
          "match": "\\b(?i:AT|TAB|LINE)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.jbas",
          "match": "\\b(?i:LET|DIM|DATA|READ|RESTORE|RANDOMIZE|CLEAR|POKE|OUT|NEW|DEF\\s*FN|FN|OPEN\\s*#|CLOSE\\s*#)\\b"
        },
        {
          "name": "keyword.other.print.jbas",
          "match": "\\b(?i:PRINT|LPRINT|LIST|LLIST)\\b"
        },
        {
          "name": "keyword.other.storage.jbas",
          "match": "\\b(?i:LOAD|SAVE|VERIFY|MERGE|CAT|FORMAT|MOVE|ERASE)\\b"
        }
      ]
    },
    "builtInFunctions": {
      "patterns": [
        {
          "name": "support.function.math.jbas",
          "match": "\\b(?i:RND|PI|INT|ABS|SGN|SQR|EXP|LN|SIN|COS|TAN|ASN|ACS|ATN)\\b"
        },
        {
          "name": "support.function.string.jbas",
          "match": "\\b(?i:STR\\$|CHR\\$|CODE|VAL\\$|VAL|LEN|INKEY\\$)\\b"
        },
        {
          "name": "support.function.system.jbas",
          "match": "\\b(?i:PEEK|IN|USR|ATTR|POINT|SCREEN\\$)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.jbas",
          "match": "\\b(?i:AND|OR|NOT)\\b"
        },
        {
          "name": "keyword.operator.comparison.jbas",
          "match": "<=|>=|<>|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.jbas",
          "match": "\\+|-|\\*|/|\\^"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.jbas",
          "match": "\\b(?i:BIN)\\s+([01]+)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.binary.digits.jbas"
            }
          }
        },
        {
          "name": "constant.numeric.decimal.jbas",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.statement.jbas",
          "match": ":"
        },
        {
          "name": "punctuation.separator.jbas",
          "match": ";|,"
        }
      ]
    }
  }
}