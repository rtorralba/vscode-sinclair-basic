{
  "name": "sinclair-basic",
  "displayName": "Sinclair BASIC",
  "description": "Sinclair BASIC language support for Visual Studio Code. Includes syntax highlighting, renumbering, optional modern syntax (jbas), TAP builder and emulator integration.",
  "version": "1.0.2",
  "publisher": "rtorralba",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "sinclair basic",
    "zx spectrum",
    "retrocomputing",
    "basic",
    "jbas",
    "tap",
    "renumber",
    "fuse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rtorralba/vscode-sinclair-basic.git"
  },
  "main": "./src/extension.js",
  "browser": "./dist/webExtension.js",
  "scripts": {
    "build-web": "esbuild ./src/webExtension.js --bundle --format=cjs --platform=browser --external:vscode --external:fs --external:path --outfile=dist/webExtension.js",
    "vscode:prepublish": "npm run build-web",
    "test": "node -c src/extension.js && node -c src/webExtension.js && npm run build-web && node --test test/*.test.js",
    "package": "npm run build-web && vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "sinclair-basic",
        "aliases": [
          "Sinclair BASIC",
          "ZX Spectrum BASIC",
          "sinclair-basic"
        ],
        "extensions": [
          ".bas"
        ],
        "configuration": "./language-configuration-bas.json"
      },
      {
        "id": "jbas",
        "aliases": [
          "jbas",
          "Pseudo-Sinclair BASIC",
          "jbas-lang"
        ],
        "extensions": [
          ".jbas"
        ],
        "configuration": "./language-configuration-jbas.json"
      }
    ],
    "grammars": [
      {
        "language": "sinclair-basic",
        "scopeName": "source.sinclair-basic",
        "path": "./syntaxes/sinclair-basic.tmLanguage.json"
      },
      {
        "language": "jbas",
        "scopeName": "source.jbas",
        "path": "./syntaxes/jbas.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sinclairBasic.compileJBas",
        "title": "Compile JBAS to TAP",
        "category": "Sinclair BASIC",
        "icon": "$(package)"
      },
      {
        "command": "sinclairBasic.compileJBasToTap",
        "title": "Compile JBAS to TAP",
        "category": "Sinclair BASIC"
      },
      {
        "command": "sinclairBasic.transpileJBas",
        "title": "Transpile JBAS to BAS",
        "category": "Sinclair BASIC",
        "icon": "$(file-code)"
      },
      {
        "command": "sinclairBasic.compileBas",
        "title": "Compile BAS to TAP",
        "category": "Sinclair BASIC",
        "icon": "$(package)"
      },
      {
        "command": "sinclairBasic.renumber",
        "title": "Renumber BAS Lines (.bas)",
        "category": "Sinclair BASIC",
        "icon": "$(list-ordered)"
      },
      {
        "command": "sinclairBasic.renumberBas",
        "title": "Renumber BAS Lines (.bas)",
        "category": "Sinclair BASIC"
      },
      {
        "command": "sinclairBasic.buildTap",
        "title": "Build TAP File (bas2tap)",
        "category": "Sinclair BASIC",
        "icon": "$(package)"
      },
      {
        "command": "sinclairBasic.runEmulator",
        "title": "Run in Emulator",
        "category": "Sinclair BASIC",
        "icon": "$(play)"
      },
      {
        "command": "sinclairBasic.runTurbo80",
        "title": "Run in Web Emulator (Turbo80)",
        "category": "Sinclair BASIC",
        "icon": "$(globe)"
      },
      {
        "command": "sinclairBasic.runExternalEmulator",
        "title": "Run in External Emulator (Fuse)",
        "category": "Sinclair BASIC",
        "icon": "$(terminal)"
      },
      {
        "command": "sinclairBasic.selectBas2tap",
        "title": "Select bas2tap Executable...",
        "category": "Sinclair BASIC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sinclairBasic.selectEmulator",
        "title": "Select Emulator Executable...",
        "category": "Sinclair BASIC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sinclairBasic.formatKeywords",
        "title": "Format Keywords to Uppercase",
        "category": "Sinclair BASIC",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "sinclairBasic.shareTurbo80",
        "title": "Share on Turbo80.com (Get Web Link)",
        "category": "Sinclair BASIC",
        "icon": "$(broadcast)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sinclairBasic.transpileJBas",
          "when": "editorLangId == jbas",
          "group": "navigation@1"
        },
        {
          "command": "sinclairBasic.compileJBas",
          "when": "editorLangId == jbas",
          "group": "navigation@2"
        },
        {
          "command": "sinclairBasic.renumber",
          "when": "editorLangId == sinclair-basic",
          "group": "navigation@1"
        },
        {
          "command": "sinclairBasic.compileBas",
          "when": "editorLangId == sinclair-basic",
          "group": "navigation@2"
        },
        {
          "command": "sinclairBasic.runEmulator",
          "when": "editorLangId == sinclair-basic || editorLangId == jbas",
          "group": "navigation@3"
        },
        {
          "command": "sinclairBasic.shareTurbo80",
          "when": "editorLangId == sinclair-basic || editorLangId == jbas",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "sinclairBasic.transpileJBas",
          "when": "editorLangId == jbas",
          "group": "1_modification@1"
        },
        {
          "command": "sinclairBasic.compileJBas",
          "when": "editorLangId == jbas",
          "group": "2_build@1"
        },
        {
          "command": "sinclairBasic.renumber",
          "when": "editorLangId == sinclair-basic",
          "group": "1_modification@1"
        },
        {
          "command": "sinclairBasic.compileBas",
          "when": "editorLangId == sinclair-basic",
          "group": "2_build@1"
        },
        {
          "command": "sinclairBasic.formatKeywords",
          "when": "editorLangId == sinclair-basic || editorLangId == jbas",
          "group": "1_modification@2"
        },
        {
          "command": "sinclairBasic.runEmulator",
          "when": "editorLangId == sinclair-basic || editorLangId == jbas",
          "group": "2_build@2"
        },
        {
          "command": "sinclairBasic.shareTurbo80",
          "when": "editorLangId == sinclair-basic || editorLangId == jbas",
          "group": "2_build@3"
        }
      ],
      "explorer/context": [
        {
          "command": "sinclairBasic.transpileJBas",
          "when": "resourceExtname == .jbas",
          "group": "sinclair@1"
        },
        {
          "command": "sinclairBasic.compileJBas",
          "when": "resourceExtname == .jbas",
          "group": "sinclair@2"
        },
        {
          "command": "sinclairBasic.renumber",
          "when": "resourceExtname == .bas",
          "group": "sinclair@1"
        },
        {
          "command": "sinclairBasic.compileBas",
          "when": "resourceExtname == .bas",
          "group": "sinclair@2"
        },
        {
          "command": "sinclairBasic.formatKeywords",
          "when": "resourceExtname == .bas || resourceExtname == .jbas",
          "group": "sinclair@3"
        },
        {
          "command": "sinclairBasic.runEmulator",
          "when": "resourceExtname == .bas || resourceExtname == .jbas",
          "group": "sinclair@4"
        },
        {
          "command": "sinclairBasic.shareTurbo80",
          "when": "resourceExtname == .bas || resourceExtname == .jbas || resourceExtname == .tap",
          "group": "sinclair@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sinclairBasic.formatKeywords",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && (editorLangId == sinclair-basic || editorLangId == jbas)"
      },
      {
        "command": "sinclairBasic.transpileJBas",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus && editorLangId == jbas"
      },
      {
        "command": "sinclairBasic.compileJBas",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == jbas"
      },
      {
        "command": "sinclairBasic.compileBas",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == sinclair-basic"
      },
      {
        "command": "sinclairBasic.renumber",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && editorLangId == sinclair-basic"
      },
      {
        "command": "sinclairBasic.runEmulator",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && (editorLangId == sinclair-basic || editorLangId == jbas)"
      }
    ],
    "configuration": {
      "title": "Sinclair BASIC",
      "properties": {
        "sinclairBasic.emulatorType": {
          "type": "string",
          "enum": [
            "turbo80",
            "external"
          ],
          "enumDescriptions": [
            "Built-in Turbo80 web emulator inside VS Code (no installation required).",
            "External desktop emulator (e.g. Fuse, RetroArch, etc.)."
          ],
          "default": "turbo80",
          "description": "Emulator engine to use when running BASIC programs.",
          "order": 1
        },
        "sinclairBasic.turbo80Model": {
          "type": "string",
          "enum": [
            "48k",
            "128k",
            "plus2",
            "plus2a",
            "plus3",
            "16k"
          ],
          "default": "48k",
          "description": "ZX Spectrum model to emulate in the built-in Turbo80 web emulator.",
          "order": 2
        },
        "sinclairBasic.turbo80Crt": {
          "type": "boolean",
          "default": true,
          "description": "Enable CRT screen shader effect in Turbo80.",
          "order": 3
        },
        "sinclairBasic.emulatorPath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Fuse\\fuse.exe",
          "description": "Path to the ZX Spectrum emulator executable (only used if emulatorType is set to 'external').",
          "markdownDescription": "Path to the ZX Spectrum emulator executable (only used if emulatorType is set to 'external').\n\n[📁 Browse for emulator executable...](command:sinclairBasic.selectEmulator)",
          "order": 4
        },
        "sinclairBasic.emulatorArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments to pass to the external emulator.",
          "order": 5
        },
        "sinclairBasic.outputDirectory": {
          "type": "string",
          "default": "dist",
          "description": "Output directory relative to the workspace root for compiled .bas and .tap files.",
          "order": 6
        },
        "sinclairBasic.autoStartLine": {
          "type": "number",
          "default": 0,
          "description": "Autostart line number passed to bas2tap (-a flag). Set to 0 to automatically detect the first line.",
          "order": 7
        },
        "sinclairBasic.useExternalBas2Tap": {
          "type": "boolean",
          "default": false,
          "description": "Set to true to use an external bas2tap executable instead of the built-in native pure JavaScript TAP generator.",
          "order": 8
        },
        "sinclairBasic.bas2tapPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bas2tap executable for creating ZX Spectrum .tap files (only if useExternalBas2Tap is enabled).",
          "markdownDescription": "Path to the bas2tap executable for creating ZX Spectrum .tap files (only if useExternalBas2Tap is enabled).\n\n[📁 Browse for bas2tap executable...](command:sinclairBasic.selectBas2tap)",
          "order": 9
        },
        "sinclairBasic.renumberStart": {
          "type": "number",
          "default": 10,
          "description": "Default start line number for the Renumber command.",
          "order": 10
        },
        "sinclairBasic.renumberStep": {
          "type": "number",
          "default": 10,
          "description": "Default step increment between line numbers for the Renumber command.",
          "order": 11
        },
        "sinclairBasic.optimizePrintAttributes": {
          "type": "boolean",
          "default": true,
          "description": "Automatically optimize constant PRINT attribute modifiers (AT, PAPER, INK, FLASH, BRIGHT, etc.) into control code strings for maximum speed and memory savings on ZX Spectrum.",
          "order": 12
        }
      }
    }
  }
}