{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*@[a-zA-Z0-9_]+\\s*:.*$",
    "decreaseIndentPattern": "^\\b$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*@[a-zA-Z0-9_]+\\s*:.*$",
      "action": {
        "indentAction": "indent"
      }
    }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(@[a-zA-Z0-9_]+:)",
      "end": "^\\s*(RETURN|STOP|GO TO)"
    }
  }
}
