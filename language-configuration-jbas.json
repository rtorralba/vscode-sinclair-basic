{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(@[a-zA-Z0-9_]+:)",
      "end": "^\\s*(RETURN|STOP|GO TO)"
    }
  }
}
